{
  "manifest_version": 3,
  "name": "New Tab Link Indicator",
  "version": "1.0.0",
  "description": "Shows new-tab links and direct image links on web pages.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://discord.com/*",
        "*://*.discord.com/*",
        "*://discordapp.com/*",
        "*://*.discordapp.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
